/1.5 Inter,\n    sans-serif;\n  color: #aebaa3;\n  margin-top: 4px;\n}\n.kit-stock {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 10px;\n  margin: 18px 0;\n}\n.kit-stock > span {\n  padding: 12px 8px;\n  text-align: center;\n  border: 1px solid #394535;\n  border-radius: 5px;\n  color: #aebaa3;\n  font-size: 12px;\n}\n.kit-stock strong {\n  display: block;\n  font-size: 24px;\n  color: #eee4ca;\n  margin-top: 4px;\n  font-weight: 500;\n}\n.kit-modes {\n  display: flex;\n  border-bottom: 1px solid #394535;\n  margin-bottom: 20px;\n  gap: 8px;\n}\n.kit-modes button {\n  flex: 1;\n  padding: 12px 3px;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  background: transparent;\n  color: #bac5b1;\n  font: inherit;\n  font-size: 13px;\n  cursor: pointer;\n}\n.kit-modes button[aria-pressed='true'] {\n  border-bottom-color: #d3b574;\n  color: #eeddb1;\n}\n.buy-destination {\n  margin-top: 16px;\n}\n.kit-review {\n  padding: 18px;\n  border: 1px solid #45533b;\n  border-radius: 5px;\n  margin-top: 18px;\n}\n.kit-review > small {\n  color: #aebaa3;\n  font-size: 11px;\n}\n.kit-review h3 {\n  display: flex;\n  gap: 9px;\n  align-items: center;\n  flex-wrap: wrap;\n  font-size: 23px;\n  margin: 8px 0;\n  font-weight: 500;\n}\n.kit-review .button {\n  width: 100%;\n  white-space: normal;\n}\n.kit-review p {\n  margin: 8px 0 16px;\n}\n.kit-inspector .inspector-note {\n  font-size: 12px;\n  margin: 18px 0 0;\n}\n.armory-footnote {\n  margin: 18px 0 0;\n}\n.army-command button:focus-visible,\n.armory-command button:focus-visible,\n.army-command input:focus-visible,\n.army-command select:focus-visible,\n.armory-command input:focus-visible,\n.armory-command select:focus-visible {\n  outline: 2px solid #edcf83;\n  outline-offset: 3px;\n}\n@media (max-width: 1100px) {\n  .armory-layout {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .barracks-band {\n    flex-wrap: wrap;\n  }\n  .barracks-band .capacity-track {\n    min-width: 200px;\n  }\n  .kit-columns,\n  .kit-choice {\n    grid-template-columns: minmax(0, 1fr) 70px 65px 70px;\n  }\n}\n@media (max-width: 760px) {\n  .force-grid,\n  .command-forms {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .force-card,\n  .command-forms > section,\n  .barracks-band,\n  .kit-catalog,\n  .kit-inspector {\n    padding: 18px;\n  }\n  .force-strip {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n    padding: 16px;\n  }\n  .force-selector button span {\n    display: block;\n    margin: 4px 0 0;\n  }\n  .barracks-band > .button {\n    width: 100%;\n  }\n  .kit-columns,\n  .kit-choice {\n    grid-template-columns: minmax(0, 1fr) 46px 40px 45px;\n    gap: 5px;\n  }\n  .kit-name {\n    gap: 6px;\n  }\n  .kit-name > svg {\n    width: 18px;\n  }\n  .kit-name > span {\n    font-size: 16px;\n  }\n  .kit-choice {\n    padding: 15px 8px;\n  }\n  .kit-columns {\n    padding: 0 8px;\n    font-size: 9px;\n  }\n  .command-inputs {\n    gap: 12px;\n    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);\n  }\n  .command-notice {\n    align-items: stretch;\n    flex-direction: column;\n  }\n  .force-numbers strong {\n    font-size: 44px;\n  }\n}\n"],["STYLE",{},".admin-switch {\n  position: fixed;\n  bottom: 18px;\n  right: 22px;\n  z-index: 45;\n  box-shadow: 0 4px 18px #0003;\n}\n.admin-dashboard {\n  max-width: 1400px;\n  margin: auto;\n  padding: 48px 32px 70px;\n  color: #302e26;\n}\n.admin-heading,\n.admin-section-title {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 24px;\n  flex-wrap: wrap;\n}\n.admin-dashboard h1 {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 54px;\n  margin: 12px 0;\n}\n.admin-dashboard h2 {\n  font-size: 27px;\n  margin: 0 0 12px;\n  font-family: 'Cormorant Garamond', serif;\n}\n.admin-dashboard p {\n  line-height: 1.6;\n  color: #686657;\n}\n.admin-stats {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n  margin: 30px 0;\n}\n.admin-stats article,\n