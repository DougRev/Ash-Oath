der: 1px solid #394535;\n  border-radius: 6px;\n}\n"],["STYLE",{},".army-command,\n.armory-command {\n  --army-surface: #17221b;\n  --army-border: #394535;\n  --army-muted: #aebaa3;\n  --army-gold: #d3b574;\n  color: #eee4ca;\n}\n.force-grid,\n.command-forms {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 20px;\n}\n.force-card,\n.command-forms > section,\n.barracks-band,\n.kit-catalog,\n.kit-inspector {\n  background: var(--army-surface);\n  border: 1px solid var(--army-border);\n  border-radius: 6px;\n  padding: 24px;\n  min-width: 0;\n}\n.force-card header {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  color: var(--army-gold);\n}\n.force-card h2,\n.command-forms h2,\n.kit-catalog h2,\n.kit-inspector h2 {\n  margin: 0;\n  font-size: 29px;\n  color: #eee4ca;\n  font-weight: 500;\n}\n.army-command p,\n.armory-command p {\n  font-size: 13px;\n  line-height: 1.65;\n  color: var(--army-muted);\n}\n.force-card header p {\n  margin: 2px 0 0;\n}\n.force-numbers {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  margin: 22px 0;\n  text-align: center;\n}\n.force-numbers > div {\n  display: grid;\n  gap: 2px;\n}\n.force-numbers > div + div {\n  border-left: 1px solid var(--army-border);\n}\n.force-numbers strong {\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 48px;\n  line-height: 1.05;\n  font-weight: 600;\n}\n.force-numbers span {\n  font-size: 13px;\n  color: var(--army-muted);\n}\n.readiness-line {\n  display: grid;\n  grid-template-columns: 65px minmax(0, 1fr) 70px;\n  align-items: center;\n  gap: 12px;\n  font-size: 13px;\n  margin: 12px 0;\n}\n.readiness-line strong {\n  text-align: right;\n  font-weight: 500;\n  font-variant-numeric: tabular-nums;\n}\n.army-command progress {\n  appearance: none;\n  width: 100%;\n  height: 9px;\n  border: 0;\n  border-radius: 10px;\n  overflow: hidden;\n  background: #2a3830;\n}\n.army-command progress::-webkit-progress-bar {\n  background: #2a3830;\n  border-radius: 10px;\n}\n.army-command progress::-webkit-progress-value {\n  background: #d3b574;\n  border-radius: 10px;\n}\n.army-command progress::-moz-progress-bar {\n  background: #d3b574;\n  border-radius: 10px;\n}\n.gear-gaps {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 20px;\n  margin: 18px 0;\n}\n.army-command .needs-gear,\n.armory-command .needs-gear {\n  color: #e0b573;\n}\n.force-mix {\n  border-top: 1px solid var(--army-border);\n  padding-top: 14px;\n  min-height: 38px;\n  margin: 0 0 14px;\n}\n.force-card > .button {\n  width: 100%;\n}\n.force-card .force-deployment {\n  color: #e0b573;\n}\n.barracks-band {\n  display: flex;\n  gap: 22px;\n  align-items: center;\n  margin: 20px 0;\n  padding: 18px 24px;\n}\n.barracks-band h3 {\n  font-size: 24px;\n  margin: 0;\n}\n.barracks-band span {\n  font-size: 12px;\n  color: var(--army-muted);\n}\n.capacity-track {\n  flex: 1;\n  display: grid;\n  gap: 9px;\n  min-width: 100px;\n}\n.barracks-band > .button {\n  white-space: normal;\n}\n.doctrine-section {\n  margin: 20px 0;\n}\n.doctrine-section .section-heading {\n  margin-bottom: 12px;\n}\n.doctrine-section .section-heading h2 {\n  margin: 0;\n  color: #eee4ca;\n  font-size: 26px;\n}\n.doctrine-section .section-heading p {\n  margin: 4px 0 0;\n}\n.doctrine-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n}\n.doctrine-grid > article {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 16px;\n  padding: 20px;\n  background: linear-gradient(135deg, #1a251d, #121c16);\n  border: 1px solid var(--army-border);\n  border-radius: 6px;\n}\n.doctrine-grid > article > svg {\n  color: var(--army-gold);\n}\n.doctrine-grid span,\n.doctrine-grid small,\n.doctrine-grid strong {\n  display: block;\n}\n.doctrine-grid span {\n  color: var(--army-muted);\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n.doctrine-grid strong {\n  margin: 4px 0;\n  font: 600 22px/1.1 'Cormorant Garamond', serif;\n  color: #eee4ca;\n}\n.doctrine-grid small {\n  color: var(--army-muted);\n  font-size: 11px;\n}\n@media (max-width: 840px) {\n  .doctrine-grid {\n    grid-template-columns: 1fr;\n  }\n}\n@media (max-width: 560px) {\n  .doctrine-grid > article {\n    grid-template-columns: auto minmax(0, 1fr);\n  }\n  .doctrine-grid > article > .button {\n    grid-column: 1 / -1;\n    width: 100%;\n  }\n}\n.command-forms p {\n  margin: 8px 0 16px;\n}\n.command-inputs {\n  display: grid;\n  grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);\n  gap: 16px;\n}\n.command-forms label,\n.kit-inspector label {\n  display: grid;\n  gap: 8px;\n  font-size: 13px;\n}\n.command-forms input,\n.command-forms select,\n.kit-inspector input,\n.kit-inspector select {\n  width: 100%;\n  min-width: 0;\n  color: #eee4ca;\n  background: #101a14;\n  border: 1px solid #526049;\n  border-radius: 5px;\n  padding: 11px 12px;\n  font: inherit;\n  font-size: 14px;\n}\n.command-presets {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  margin: 14px 0;\n}\n.command-presets button {\n  border: 1px solid #526049;\n  color: #dbcfad;\n  background: transparent;\n  border-radius: 4px;\n  padding: 8px 12px;\n  font: inherit;\n  font-size: 12px;\n  cursor: pointer;\n}\n.command-presets button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.command-forms .order-review {\n  min-height: 22px;\n  color: #e8dab8;\n}\n.command-forms > section > .button {\n  width: 100%;\n}\n.command-forms .transfer-explanation {\n  margin-top: 22px;\n  min-height: 58px;\n}\n.command-notice {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  padding: 16px 24px;\n  border: 1px solid #6d633e;\n  margin-bottom: 20px;\n  border-radius: 6px;\n}\n.force-selector {\n  display: flex;\n  gap: 4px;\n  margin-bottom: 16px;\n}\n.force-selector button {\n  flex: 1;\n  padding: 14px;\n  background: #17221b;\n  border: 1px solid #394535;\n  border-radius: 5px;\n  