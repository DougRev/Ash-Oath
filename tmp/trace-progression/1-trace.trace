g-actions {\n    gap: 10px;\n    flex-direction: column;\n  }\n  body .dialog-actions > .button {\n    width: 100%;\n    font-size: 11px;\n  }\n  body .chest-reveal {\n    height: 227px;\n  }\n  body .chest-dialog .item-tile h3 {\n    font-size: 35px;\n  }\n  body .chest-dialog .dialog-body {\n    padding-top: 9px;\n  }\n  body .settings-row {\n    gap: 11px;\n  }\n  body .settings-row > svg {\n    width: 18px;\n  }\n  body .settings-row h3 {\n    font-size: 22px;\n  }\n  body .settings-row > .button {\n    font-size: 9px;\n    padding: 9px;\n  }\n  body .demo-controls {\n    padding: 19px;\n  }\n  body .demo-controls h3 {\n    font-size: 26px;\n  }\n  body .demo-controls p {\n    font-size: 10px;\n  }\n  body .reset-area label {\n    font-size: 10px;\n    line-height: 1.7;\n  }\n  body .guide-row {\n    gap: 14px;\n  }\n  body .guide-row h3 {\n    font-size: 25px;\n  }\n  body .guide-row p {\n    font-size: 10px;\n    line-height: 1.9;\n  }\n  body .guide-row > svg {\n    width: 20px;\n  }\n  body .note {\n    font-size: 10px;\n    line-height: 1.8;\n  }\n  body .toast-container {\n    max-width: calc(100vw - 24px);\n  }\n  body .toast {\n    font-size: 10px;\n    gap: 8px;\n  }\n}\n@media (max-width: 700px) {\n  body .sidebar {\n    visibility: hidden;\n  }\n  body .sidebar.mobile-open {\n    visibility: visible;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n    scroll-behavior: auto !important;\n  }\n}\n:root {\n  font-family: 'Inter', sans-serif;\n  color: #eeeade;\n  background: #101615;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  --bg: #101615;\n  --surface: #141c18;\n  --deep: #0d1312;\n  --text: #eeeade;\n  --muted: #a3ada4;\n  --dim: #78867d;\n  --gold: #d1af6d;\n  --line: #344037;\n  --gold-line: #62583d;\n  --green: #8fb78f;\n  --danger: #cf8775;\n  --serif: 'Cormorant Garamond', Georgia, serif;\n}\n* {\n  box-sizing: border-box;\n}\nbody {\n  margin: 0;\n  min-width: 320px;\n}\nbutton,\ninput,\nselect {\n  font: inherit;\n}\nbutton {\n  cursor: pointer;\n  color: inherit;\n}\nbutton:disabled {\n  cursor: not-allowed;\n  opacity: 0.4;\n}\nbutton,\na,\ninput,\nselect,\nsummary {\n  -webkit-tap-highlight-color: transparent;\n}\nbutton:focus-visible,\na:focus-visible,\nsummary:focus-visible,\ninput:focus-visible,\nselect:focus-visible {\n  outline: 2px solid var(--gold);\n  outline-offset: 4px;\n}\nbutton {\n  transition:\n    background 0.18s,\n    border-color 0.18s,\n    transform 0.18s,\n    color 0.18s;\n}\nh1,\nh2,\nh3,\np {\n  margin: 0;\n}\nh1,\nh2,\nh3 {\n  font-family: var(--serif);\n  font-weight: 500;\n}\nh1 {\n  font-size: 44px;\n  line-height: 1.12;\n  letter-spacing: -0.9px;\n}\nh2 {\n  font-size: 29px;\n  line-height: 1.15;\n  letter-spacing: -0.3px;\n}\nh3 {\n  font-size: 23px;\n  line-height: 1.2;\n}\np {\n  font-size: 13px;\n  line-height: 1.7;\n}\nsvg {\n  flex-shrink: 0;\n}\na {\n  color: var(--gold);\n}\n::selection {\n  background: #6c6442;\n  color: #fff;\n}\nstrong {\n  font-weight: 500;\n}\ninput,\nselect {\n  color: var(--text);\n  background: #101713;\n  border: 1px solid var(--line);\n  border-radius: 3px;\n  padding: 10px 12px;\n}\nselect {\n  color-scheme: dark;\n}\ninput[type='checkbox'] {\n  accent-color: var(--gold);\n  width: 16px;\n  height: 16px;\n  flex-shrink: 0;\n}\nbutton:disabled:hover {\n  transform: none;\n}\nimg {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n.muted {\n  color: var(--muted);\n}\n.positive {\n  color: var(--green);\n}\n.gold-text {\n  color: var(--gold);\n}\n.danger-text {\n  color: var(--danger);\n}\n.small-copy {\n  font-size: 12px;\n  line-height: 1.75;\n}\n.letter-label,\n.subtle-label {\n  font-size: 10px;\n  letter-spacing: 1.75px;\n  font-weight: 500;\n  line-height: 1.5;\n}\n.letter-label {\n  color: var(--gold);\n}\n.subtle-label {\n  color: var(--dim);\n  font-size: 9px;\n  letter-spacing: 1.15px;\n}\n.full-width {\n  width: 100%;\n}\n.panel {\n  border: 1px solid var(--line);\n  background: var(--surface);\n  border-radius: 3px;\n}\n.panel-icon {\n  color: var(--gold);\n  display: inline-flex;\n}\n.section-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n.section-heading > svg {\n  color: var(--gold);\n}\n.center-muted {\n  display: block;\n  text-align: center;\n  font-size: 11px;\n  color: var(--muted);\n  margin-top: 12px;\n  line-height: 1.6;\n}\n.inline-resource {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  white-space: nowrap;\n}\n.button {\n  border: 1px solid transparent;\n  min-height: 41px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  padding: 11px 17px;\n  border-radius: 3px;\n  font-size: 12px;\n  font-weight: 500;\n  line-height: 1.3;\n  white-space: nowrap;\n}\n.button-primary {\n  background: linear-gradient(112deg, #d9bf83, #c4a15f);\n  border-color: #ddc18a;\n  color: #1b2119;\n  box-shadow: inset 0 1px #efddb365;\n}\n.button-primary:hover:not(:disabled) {\n  background: linear-gradient(112deg, #e7d09c, #d4b271);\n  box-shadow: 0 3px 16px #c4a15f18;\n  transform: translateY(-1px);\n}\n.button-secondary {\n  color: var(--gold);\n  border-color: #56563d;\n  background: #d1af6d05;\n}\n.button-secondary:hover:not(:disabled) {\n  background: #d1af6d0e;\n  border-color: var(--gold);\n}\n.button-ghost {\n  background: transparent;\n  color: var(--muted);\n}\n.button-ghost:hover:not(:disabled) {\n  color: var(--gold);\n  background: #d1af6d08;\n}\n.button-danger {\n  color: #e5a996;\n  background: #833e282a;\n  border-color: #814f43;\n}\n.button-cost {\n  font-size: 11px;\n  opacity: 0.8;\n  border-left: 1px solid #332c243a;\n  padding-left: 10px;\n}\n.text-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  color: var(--gold);\n  background: none;\n  border: 0;\n  padding: 0;\n  font-size: 12px;\n  line-height: 1.5;\n}\n.text-link:hover {\n  color: #f0d399;\n}\n.text-link:hover svg {\n  transform: translateX(3px);\n}\n.icon-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 10px;\n  background: transparent;\n  border: 0;\n  color: #a7afa2;\n  border-radius: 3px;\n  min-width: 38px;\n  min-height: 38px;\n}\n.icon-button:hover {\n  background: #ffffff08;\n  color: var(--gold);\n}\n.status-dot {\n  display: inline-block;\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: var(--green);\n  flex-shrink: 0;\n}\n.note {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  color: #9ba998;\n  padding: 20px 0 0;\n  font-size: 12px;\n  line-height: 1.7;\n}\n.note > svg {\n  color: var(--gold);\n  margin-top: 2px;\n}\n.skip-link {\n  position: fixed;\n  top: -60px;\n  left: 240px;\n  background: var(--gold);\n  color: var(--bg);\n  padding: 10px;\n  z-index: 100;\n}\n.skip-link:focus {\n  top: 10px;\n}\n/* The persistent realm shell. */\n.sidebar {\n  position: fixed;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  width: 216px;\n  background: var(--deep);\n  border-right: 1px solid var(--gold-line);\n  display: flex;\n  flex-direction: column;\n  z-index: 30;\n  overflow-y: auto;\n}\n.sidebar:before {\n  content: '';\n  position: absolute;\n  inset: 45% 0 0;\n  background:\n    linear-gradient(#0d1312, transparent 25%, #0d1312d9 75%),\n    url('/art/stronghold.webp') 53% 50% / cover;\n  opacity: 0.13;\n  pointer-events: none;\n  z-index: -1;\n}\n.brand {\n  padding: 20px 15px 24px;\n  text-align: center;\n  border-bottom: 1px solid #3540336b;\n}\n.brand-crest {\n  height: 91px;\n  position: relative;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  color: var(--gold);\n}\n.brand-crest > svg:not(.sword-mark) {\n  margin-top: 6px;\n}\n.sword-mark {\n  position: absolute;\n  top: 0;\n  height: 88px;\n  width: 32px;\n}\n.brand-name {\n  font-family: var(--serif);\n  font-size: 28px;\n  letter-spacing: 1.2px;\n  white-space: nowrap;\n  line-height: 1.5;\n}\n.brand-name span {\n  font-size: 24px;\n  color: #c9ba98;\n}\n.brand-tagline {\n  font-size: 6.8px;\n  color: #b7b8a5;\n  letter-spacing: 1.4px;\n  white-space: nowrap;\n}\n.nav-label {\n  padding: 24px 23px 12px;\n  font-size: 9px;\n  color: #a1a88d;\n  letter-spacing: 1.8px;\n}\n.nav-item {\n  width: calc(100% - 20px);\n  margin: 0 10px 5px;\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  padding: 15px 15px;\n  border: 1px solid transparent;\n  border-radius: 2px;\n  background: none;\n  color: #aeb9af;\n  text-align: left;\n  font-size: 12px;\n  position: relative;\n}\n.nav-item svg {\n  color: #b0b49d;\n}\n.nav-item:hover {\n  background: #d1af6d07;\n  color: var(--text);\n}\n.nav-item.active {\n  border-color: #6f6140;\n  background: linear-gradient(90deg, #d4b6701a, #d4b67004);\n  color: var(--text);\n}\n.nav-item.active:before {\n  position: absolute;\n  content: '';\n  width: 2px;\n  left: -1px;\n  top: 0;\n  bottom: 0;\n  background: var(--gold);\n}\n.nav-item.active svg {\n  color: var(--gold);\n}\n.nav-indicator {\n  margin-left: auto;\n  width: 4px;\n  height: 4px;\n  background: var(--gold);\n  transform: rotate(45deg);\n}\n.sidebar-bottom {\n  margin-top: auto;\n  padding-top: 35px;\n}\n.season-summary {\n  background: none;\n  border: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 9px;\n  width: 100%;\n  padding: 10px 20px 30px;\n}\n.season-summary .ornament {\n  color: var(--gold);\n  font-size: 9px;\n  position: relative;\n  width: 100%;\n  margin-bottom: 8px;\n}\n.ornament:before,\n.ornament:after {\n  content: '';\n  width: 43%;\n  height: 1px;\n  background: #574d32;\n  position: absolute;\n  top: 50%;\n}\n.ornament:before {\n  left: 0;\n}\n.ornament:after {\n  right: 0;\n}\n.season-summary .letter-label {\n  font-size: 9px;\n  letter-spacing: 2.5px;\n}\n.season-summary strong {\n  font-family: var(--serif);\n  font-size: 27px;\n}\n.season-summary > .muted {\n  font-size: 11px;\n}\n.season-rule {\n  height: 1px;\n  width: 52px;\n  background: #64563a;\n  margin: 2px 0;\n}\n.profile {\n  display: flex;\n  align-items: center;\n  text-align: left;\n  gap: 11px;\n  width: 100%;\n  background: #0e161361;\n  border: 0;\n  border-top: 1px solid #303c34;\n  border-bottom: 1px solid #303c34;\n  padding: 21px 17px;\n}\n.avatar {\n  width: 43px;\n  height: 43px;\n  display: grid;\n  place-items: center;\n  border: 1px solid #7c714c;\n  border-radius: 50%;\n  color: var(--gold);\n  background: radial-gradient(#7f81682b, transparent);\n}\n.profile strong {\n  display: block;\n  font-family: var(--serif);\n  font-size: 18px;\n}\n.profile small {\n  display: block;\n  font-size: 9px;\n  color: var(--muted);\n  margin-top: 5px;\n}\n.settings-link {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: none;\n  border: 0;\n  color: #a3ad9e;\n  padding: 20px 24px;\n  font-size: 11px;\n}\n.settings-link:hover {\n  color: var(--gold);\n}\n.main-shell {\n  margin-left: 216px;\n}\n.resource-bar {\n  height: 78px;\n  padding: 13px 26px;\n  display: flex;\n  align-items: center;\n  background: #101814;\n  border-bottom: 1px solid #494a35;\n  gap: 0;\n}\n.resource {\n  display: flex;\n  align-items: center;\n  gap: 13px;\n  flex: 1;\n  min-width: 0;\n  height: 39px;\n  border-right: 1px solid var(--line);\n  padding: 0 26px;\n}\n.resource:first-of-type {\n  padding-left: 4px;\n}\n.resource strong {\n  display: block;\n  font-size: 17px;\n  line-height: 1.4;\n  white-space: nowrap;\n  font-variant-numeric: tabular-nums;\n}\n.resource strong em {\n  font-style: normal;\n  color: var(--muted);\n  font-size: 13px;\n}\n.resource > div > span {\n  display: block;\n  font-size: 10px;\n  color: var(--muted);\n  margin-top: 2px;\n}\n.resource-icon {\n  color: var(--gold);\n}\n.resource small {\n  font-size: 10px;\n  margin-left: auto;\n  white-space: nowrap;\n}\n.gold-resource {\n  flex: 1.5;\n}\n.ap-resource {\n  flex: 1.4;\n}\n.troop-resource {\n  flex: 0.75;\n}\n.tribute-resource {\n  flex: 0.8;\n  color: #aab29f;\n}\n.tribute-resource .timer {\n  font-size: 14px;\n}\n.tribute-resource > div > span {\n  font-size: 10px;\n  margin: 0 0 1px;\n}\n.header-actions {\n  display: flex;\n  gap: 4px;\n  padding-left: 16px;\n  align-items: center;\n}\n.help-button {\n  background: none;\n  border: 0;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 7px;\n  color: #aab39f;\n  font-size: 11px;\n}\n.help-button:hover,\n.sound-on {\n  color: var(--gold);\n}\nmain {\n  padding: 21px 26px 0;\n  max-width: 1800px;\n  margin: 0 auto;\n  outline: none;\n}\n.breadcrumb {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  font-size: 10px;\n  color: #b5bdaf;\n  margin-bottom: 18px;\n  min-height: 15px;\n}\n.breadcrumb > span:first-child {\n  color: var(--dim);\n}\n.breadcrumb > svg {\n  color: var(--dim);\n}\n.local-status {\n  margin-left: auto;\n  background: none;\n  border: 0;\n  color: #7f8e81;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 9px;\n  padding: 0;\n}\n.local-status > .status-dot {\n  width: 4px;\n  height: 4px;\n}\n.local-status:hover {\n  color: var(--muted);\n}\n.page-intro {\n  display: flex;\n  justify-content: space-between;\n  gap: 18px;\n  align-items: center;\n  margin-bottom: 23px;\n}\n.page-intro p {\n  color: var(--muted);\n  margin-top: 8px;\n  font-size: 12px;\n  letter-spacing: 0.1px;\n}\n.page-content {\n  animation: page-arrive 0.32s ease-out;\n}\n.app-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 9px;\n  color: #6c7a6e;\n  padding: 24px 0 20px;\n  margin-top: 3px;\n  gap: 10px;\n}\n.app-footer > span:first-child,\n.app-footer button {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n.app-footer > span:last-child {\n  font-size: 8px;\n  letter-spacing: 1px;\n}\n.app-footer button {\n  border: 0;\n  background: none;\n  color: #8a9584;\n  font-size: 10px;\n}\n.mobile-close,\n.menu-button,\n.sidebar-scrim {\n  display: none;\n}\n.warning-banner {\n  padding: 12px 15px;\n  font-size: 12px;\n  background: #bd875624;\n  color: #efd7a7;\n  border: 1px solid #8e7545;\n  margin-bottom: 18px;\n}\n.app-footer > span:first-child,\n.app-footer button {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n.app-footer > span:last-child > .muted {\n  display: inline;\n}\n@media (min-width: 1121px) {\n  .resource-bar {\n    height: 66px;\n  }\n  main {\n    padding-top: 16px;\n  }\n  .breadcrumb {\n    margin-bottom: 13px;\n  }\n  .page-intro {\n    margin-bottom: 20px;\n  }\n  .overview-primary .chapter-step {\n    padding: 15px 0;\n  }\n  .overview-primary .chapter-step:first-child {\n    padding-top: 3px;\n  }\n  .overview-primary .chapter-step p {\n    margin-bottom: 8px;\n  }\n  .overview-primary .chapter-quote {\n    font-size: 14px;\n  }\n}\n/* Overview: home, next chapter, and the wider world. */\n.overview-primary {\n  display: grid;\n  grid-template-columns: minmax(0, 2.28fr) minmax(290px, 1fr);\n  gap: 14px;\n}\n.realm-scene {\n  height: 407px;\n  position: relative;\n  border: 1px solid var(--gold-line);\n  border-radius: 3px;\n  overflow: hidden;\n  background: #202a1e;\n}\n.realm-scene > img {\n  object-position: center 49%;\n}\n.realm-scene:after {\n  content: '';\n  position: absolute;\n  inset: 20% 0 0;\n  background: linear-gradient(transparent 14%, #070d0740 47%, #0a1109e8 98%);\n  pointer-events: none;\n}\n.explore-link {\n  position: absolute;\n  right: 20px;\n  top: 18px;\n  z-index: 2;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  border: 0;\n  background: none;\n  text-shadow: 0 1px 6px #000;\n  color: #f5f0dc;\n  font-size: 10px;\n}\n.circle-arrow {\n  width: 33px;\n  height: 33px;\n  border: 1px solid #d1af6dc9;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  background: #16221a4a;\n  color: #edd298;\n}\n.explore-link:hover .circle-arrow {\n  background: #d1af6d40;\n}\n.realm-caption {\n  position: absolute;\n  left: 25px;\n  right: 20px;\n  bottom: 78px;\n  z-index: 2;\n}\n.realm-caption > .letter-label {\n  font-size: 8px;\n  letter-spacing: 2px;\n  color: #d5d4ba;\n  text-shadow: 0 1px 5px #000;\n}\n.realm-caption h2 {\n  font-size: 38px;\n  line-height: 1.1;\n  margin: 7px 0 6px;\n  color: #fcf4e0;\n  text-shadow: 0 2px 8px #0005;\n}\n.realm-caption p {\n  font-size: 12px;\n  line-height: 1.6;\n  color: #dbdecb;\n  display: flex;\n  gap: 9px;\n  text-shadow: 0 2px 6px #000;\n}\n.realm-caption .button {\n  margin-top: 16px;\n  min-width: 223px;\n}\n.realm-progress {\n  position: absolute;\n  z-index: 2;\n  bottom: 17px;\n  left: 35px;\n  right: 35px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n}\n.realm-step {\n  position: relative;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  color: #a9b09d;\n}\n.realm-step:before {\n  content: '';\n  position: absolute;\n  top: 6px;\n  right: 50%;\n  width: 100%;\n  height: 1px;\n  background: #aeb49c78;\n}\n.realm-step:first-child:before {\n  display: none;\n}\n.realm-step > span {\n  width: 12px;\n  height: 12px;\n  background: #263129;\n  border: 1px solid #b0b49e;\n  position: relative;\n  z-index: 1;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n}\n.realm-step small {\n  font-size: 9px;\n}\n.realm-step.reached > span {\n  background: var(--gold);\n  border-color: #e3ca92;\n  color: #213021;\n}\n.realm-step.current > span {\n  box-shadow: 0 0 12px #efc9638a;\n}\n.realm-step.current small {\n  color: #f0d092;\n}\n.chapter-panel {\n  padding: 22px 24px 17px;\n  display: flex;\n  flex-direction: column;\n  background: linear-gradient(140deg, #151d17, #101914);\n}\n.chapter-panel h2 {\n  font-size: 29px;\n  margin-bottom: 18px;\n}\n.chapter-steps {\n  flex: 1;\n}\n.chapter-step {\n  display: flex;\n  align-items: flex-start;\n  gap: 15px;\n  padding: 17px 0;\n  border-top: 1px solid #3f4535;\n}\n.chapter-step:first-child {\n  border-top: 0;\n  padding-top: 5px;\n}\n.step-number {\n  display: grid;\n  place-items: center;\n  width: 37px;\n  height: 37px;\n  border: 1px solid #aa9560;\n  border-radius: 50%;\n  flex-shrink: 0;\n  color: #e0c386;\n  font-family: var(--serif);\n  font-size: 19px;\n}\n.chapter-step h3 {\n  font-size: 24px;\n  margin-top: -1px;\n}\n.chapter-step p {\n  font-size: 11px;\n  line-height: 1.6;\n  color: var(--muted);\n  margin: 5px 0 10px;\n}\n.chapter-step .text-link {\n  font-size: 10px;\n  gap: 8px;\n}\n.chapter-step.complete .step-number {\n  color: var(--green);\n  border-color: #78926b;\n}\n.step-complete {\n  color: #789477;\n  font-size: 9px;\n}\n.chapter-quote {\n  font-family: var(--serif);\n  font-size: 15px;\n  font-style: italic;\n  text-align: right;\n  color: #858e79;\n  margin-top: 6px;\n}\n.stats-band {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  border: 1px solid var(--line);\n  border-radius: 3px;\n  margin: 13px 0;\n  min-height: 70px;\n  background: #121b16;\n}\n.stats-band > div {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin: 13px 0;\n  padding: 0 27px;\n  border-left: 1px solid var(--line);\n}\n.stats-band > div:first-child {\n  border-left: 0;\n}\n.stats-band svg {\n  width: 27px;\n  height: 27px;\n  color: #b8a87d;\n  stroke-width: 1.3;\n}\n.stats-band strong {\n  font-family: var(--serif);\n  font-size: 25px;\n  line-height: 1;\n}\n.stats-band small {\n  display: block;\n  font-size: 10px;\n  color: var(--muted);\n  margin-top: 5px;\n}\n.stat-context {\n  margin-left: auto;\n  color: #7e8d7f;\n  font-size: 9px;\n  white-space: nowrap;\n}\n.overview-secondary {\n  display: grid;\n  grid-template-columns: 1.62fr 1fr;\n  gap: 14px;\n}\n.beyond-panel,\n.war-preview {\n  padding: 17px 19px;\n}\n.beyond-panel .section-heading,\n.war-preview .section-heading {\n  margin-bottom: 12px;\n}\n.overview-secondary h2 {\n  font-size: 27px;\n}\n.dungeon-preview {\n  display: grid;\n  grid-template-columns: 1.2fr 1fr;\n  gap: 20px;\n  align-items: center;\n}\n.dungeon-preview-image {\n  height: 157px;\n  padding: 0;\n  border: 1px solid #536047;\n  border-radius: 2px;\n  background: var(--bg);\n  overflow: hidden;\n}\n.dungeon-preview-image img {\n  object-position: 65% 48%;\n  transition: transform 0.6s;\n}\n.dungeon-preview-image:hover img {\n  transform: scale(1.04);\n}\n.dungeon-preview-copy h3 {\n  font-size: 24px;\n  white-space: nowrap;\n}\n.dungeon-preview-copy p {\n  font-size: 10px;\n  color: var(--muted);\n  margin: 5px 0 11px;\n}\n.stage-label {\n  display: block;\n  font-size: 11px;\n  margin-bottom: 5px;\n}\n.odds-label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 10px;\n}\n.dungeon-preview-copy .button {\n  margin-top: 13px;\n  width: 100%;\n  padding: 10px 11px;\n  font-size: 11px;\n  gap: 8px;\n}\n.war-preview {\n  padding-bottom: 13px;\n}\n.influence-list {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.influence-list.compact {\n  gap: 11px;\n}\n.influence-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 11px;\n  min-width: 0;\n}\n.faction-symbol {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 26px;\n  flex-shrink: 0;\n}\n.faction-name {\n  width: 110px;\n  flex-shrink: 0;\n  font-size: 11px;\n}\n.faction-name small {\n  display: block;\n  color: #798b76;\n  font-size: 8px;\n  margin-top: 3px;\n}\n.influence-track {\n  flex: 1;\n  height: 6px;\n  background: #303d35;\n  min-width: 15px;\n}\n.influence-track > span {\n  display: block;\n  height: 100%;\n  min-width: 5px;\n  transition: width 0.6s;\n}\n.influence-percent {\n  font-size: 10px;\n  width: 30px;\n  text-align: right;\n}\n.war-preview-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 6px;\n  margin-top: 16px;\n}\n.war-preview-footer .text-link {\n  font-size: 10px;\n  gap: 6px;\n}\n.simulation-label {\n  font-size: 9px;\n  color: #85937e;\n  letter-spacing: 0.4px;\n}\n.activity-strip {\n  display: flex;\n  align-items: center;\n  gap: 17px;\n  border: 1px solid var(--line);\n  border-radius: 3px;\n  padding: 14px 17px;\n  margin-top: 13px;\n  font-size: 11px;\n  background: #121a15;\n}\n.activity-strip-title {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  white-space: nowrap;\n  font-family: var(--serif);\n  font-size: 18px;\n}\n.activity-strip-title svg {\n  color: var(--gold);\n  width: 15px;\n}\n.activity-strip .subtle-label {\n  padding-left: 17px;\n  border-left: 1px solid var(--line);\n  font-size: 8px;\n  flex-shrink: 0;\n}\n.activity-strip p {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 10px;\n  line-height: 1.5;\n  color: #a2ad9e;\n}\n.activity-strip > button {\n  background: none;\n  border: 0;\n  color: var(--gold);\n  display: flex;\n  gap: 6px;\n  align-items: center;\n  white-space: nowrap;\n  font-size: 10px;\n  margin-left: auto;\n  padding: 0;\n}\n.overview-primary > .realm-scene {\n  height: auto;\n  min-height: 420px;\n}\n.overview-primary > .realm-scene > img {\n  position: absolute;\n  inset: 0;\n}\n/* Settlement and buildings. */\n.settlement-layout {\n  display: grid;\n  grid-template-columns: 1.8fr 1fr;\n  gap: 18px;\n}\n.settlement-scene {\n  height: 426px;\n}\n.settlement-scene .realm-caption {\n  bottom: 86px;\n}\n.settlement-scene .realm-caption h2 {\n  font-size: 48px;\n}\n.upgrade-panel {\n  padding: 28px;\n  display: flex;\n  flex-direction: column;\n}\n.upgrade-panel > .panel-icon {\n  margin-bottom: 20px;\n}\n.upgrade-panel h2 {\n  font-size: 33px;\n  margin: 7px 0 12px;\n}\n.upgrade-panel > p {\n  color: var(--muted);\n  font-size: 12px;\n}\n.upgrade-benefits {\n  margin: 22px 0 26px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.upgrade-benefits > div {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 10px;\n  color: #b3bdac;\n}\n.upgrade-benefits > div > svg {\n  color: var(--gold);\n}\n.upgrade-benefits strong {\n  margin-left: auto;\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  font-size: 11px;\n  color: var(--text);\n}\n.upgrade-benefits strong > svg {\n  color: var(--dim);\n}\n.upgrade-panel > .button {\n  margin-top: auto;\n}\n.map-pins {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n}\n.map-pin {\n  position: absolute;\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  background: #152118da;\n  border: 1px solid #a9905d;\n  border-radius: 3px;\n  color: #ead49f;\n  padding: 8px;\n  font-size: 9px;\n  box-shadow: 0 3px 20px #0005;\n}\n.pin-0 {\n  left: 29%;\n  top: 34%;\n}\n.pin-1 {\n  left: 55%;\n  top: 42%;\n}\n.pin-2 {\n  left: 14%;\n  top: 50%;\n}\n.pin-3 {\n  left: 69%;\n  top: 23%;\n}\n.buildings-heading {\n  margin: 30px 0 18px;\n}\n.building-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 15px;\n}\n.building-card {\n  padding: 22px 20px;\n  display: flex;\n  flex-direction: column;\n}\n.building-card-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 20px;\n}\n.building-icon {\n  color: var(--gold);\n}\n.building-status {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 9px;\n}\n.building-card h3 {\n  font-size: 26px;\n}\n.building-card p {\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.8;\n  margin-top: 8px;\n  min-height: 62px;\n}\n.building-benefit {\n  margin: 20px 0;\n  color: #c3cdb8;\n  font-size: 10px;\n  min-height: 30px;\n  line-height: 1.6;\n}\n.building-card .button {\n  margin-top: auto;\n  width: 100%;\n  font-size: 10px;\n  padding: 10px;\n  gap: 8px;\n}\n.is-built {\n  border-color: #4e5a40;\n}\n/* Army and inventory. */\n.page-tabs {\n  display: flex;\n  align-items: center;\n  gap: 27px;\n  border-bottom: 1px solid var(--line);\n  margin-bottom: 24px;\n}\n.page-tabs > button {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  background: none;\n  padding: 4px 1px 14px;\n  color: #9ea99b;\n  font-size: 12px;\n}\n.page-tabs > button.selected {\n  border-bottom-color: var(--gold);\n  color: var(--gold);\n}\n.count-badge {\n  font-size: 9px;\n  min-width: 20px;\n  text-align: center;\n  background: #cbb17420;\n  padding: 3px 6px;\n  border-radius: 3px;\n}\n.army-banner {\n  display: flex;\n  align-items: center;\n  gap: 23px;\n  padding: 24px;\n}\n.army-banner h2 {\n  font-size: 29px;\n}\n.army-banner p {\n  color: var(--muted);\n  font-size: 11px;\n  margin-top: 5px;\n}\n.army-banner > .button {\n  margin-left: auto;\n}\n.unlock-banner {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  padding: 20px 23px;\n  background: #5e573524;\n  border: 1px solid #665b35;\n  border-radius: 3px;\n  margin: 20px 0;\n  color: var(--gold);\n}\n.unlock-banner > div {\n  flex: 1;\n}\n.unlock-banner h3 {\n  font-size: 23px;\n  color: #e4d8b2;\n}\n.unlock-banner p {\n  font-size: 11px;\n  color: #a8ad96;\n  margin-top: 4px;\n}\n.unlock-banner .button {\n  font-size: 11px;\n}\n.recruit-toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin: 29px 0 18px;\n  gap: 12px;\n}\n.recruit-toolbar label {\n  display: flex;\n  gap: 11px;\n  align-items: center;\n  font-size: 11px;\n  color: var(--muted);\n}\n.recruit-toolbar select {\n  font-size: 11px;\n  min-width: 114px;\n}\n.troop-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n}\n.troop-panel {\n  padding: 26px;\n}\n.troop-panel-title {\n  display: flex;\n  align-items: center;\n  gap: 24px;\n}\n.troop-emblem {\n  height: 91px;\n  width: 82px;\n  background: #b5996011;\n  color: #b9a577;\n  border: 1px solid #7167466b;\n  display: grid;\n  place-items: center;\n  clip-path: polygon(0 0, 100% 0, 100% 78%, 50% 100%, 0 78%);\n}\n.troop-emblem.defense {\n  color: #9fb09c;\n  background: #788d7012;\n  border-color: #63745b70;\n}\n.troop-panel-title .letter-label {\n  font-size: 8px;\n}\n.troop-panel-title h2 {\n  font-size: 36px;\n  margin: 7px 0 4px;\n}\n.troop-panel-title p {\n  font-size: 11px;\n  color: var(--muted);\n}\n.troop-stats {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  margin: 28px 0 20px;\n  padding: 19px 0;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n}\n.troop-stats > div {\n  border-left: 1px solid var(--line);\n  padding-left: 21px;\n}\n.troop-stats > div:first-child {\n  border-left: 0;\n  padding-left: 0;\n}\n.troop-stats strong {\n  font-family: var(--serif);\n  font-size: 33px;\n  line-height: 1;\n}\n.troop-stats strong em {\n  font-style: normal;\n  font-size: 20px;\n  color: var(--dim);\n}\n.troop-stats span {\n  display: block;\n  font-size: 10px;\n  color: var(--muted);\n  margin-top: 7px;\n}\n.troop-description {\n  color: var(--muted);\n  font-size: 11px;\n  min-height: 50px;\n  margin-bottom: 20px;\n}\n.troop-secondary-actions {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  margin-top: 17px;\n}\n.troop-secondary-actions > button {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: none;\n  border: 0;\n  padding: 0;\n  color: #b8b99a;\n  font-size: 10px;\n  min-height: 24px;\n}\n.blacksmith-banner {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  padding: 23px;\n  margin-top: 23px;\n  color: var(--gold);\n}\n.blacksmith-banner > div {\n  flex: 1;\n}\n.blacksmith-banner h3 {\n  color: var(--text);\n  font-size: 25px;\n}\n.blacksmith-banner p {\n  font-size: 11px;\n  color: var(--muted);\n  margin-top: 5px;\n}\n.blacksmith-banner > .positive {\n  font-size: 11px;\n}\n.hero-profile {\n  display: flex;\n  align-items: center;\n  gap: 25px;\n  padding: 32px;\n}\n.hero-sigil {\n  height: 119px;\n  width: 102px;\n  display: grid;\n  place-items: center;\n  border: 1px solid #78633d;\n  border-radius: 50% 50% 4px 4px;\n  background: radial-gradient(#c6af6226, transparent);\n  color: var(--gold);\n}\n.hero-profile h2 {\n  font-size: 38px;\n  margin: 7px 0;\n}\n.hero-profile p {\n  font-size: 11px;\n  color: var(--muted);\n}\n.hero-stat-line {\n  display: flex;\n  align-items: center;\n  gap: 17px;\n  margin-top: 18px;\n  font-size: 11px;\n  color: #b2bba6;\n}\n.hero-stat-line > span {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.personal-strength {\n  margin-left: auto;\n  text-align: center;\n  padding-left: 24px;\n  border-left: 1px solid var(--line);\n}\n.personal-strength strong {\n  font-family: var(--serif);\n  font-size: 56px;\n  color: var(--gold);\n  line-height: 1;\n}\n.personal-strength span {\n  display: block;\n  font-size: 11px;\n  margin-top: 8px;\n}\n.personal-strength small {\n  display: block;\n  font-size: 9px;\n  color: var(--muted);\n  margin-top: 7px;\n}\n.loadout-summary {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  border: 1px solid var(--line);\n  background: #121a15;\n  margin-top: 18px;\n}\n.loadout-summary > div {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 22px;\n  border-left: 1px solid var(--line);\n  border-top: 1px solid var(--line);\n  color: var(--gold);\n}\n.loadout-summary > div:first-child {\n  border-left: 0;\n}\n.loadout-summary > div:nth-child(-n + 3) {\n  border-top: 0;\n}\n.loadout-summary > div:nth-child(3n + 1) {\n  border-left: 0;\n}\n.loadout-summary small {\n  font-size: 9px;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: var(--dim);\n  display: block;\n  margin-bottom: 8px;\n}\n.loadout-summary strong {\n  font-size: 11px;\n  color: var(--text);\n}\n.inventory-section {\n  margin-top: 30px;\n}\n.filter-tabs {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  margin: 0 0 21px;\n  flex-wrap: wrap;\n}\n.filter-tabs > button {\n  background: none;\n  border: 1px solid transparent;\n  color: #9fac9b;\n  font-size: 11px;\n  padding: 9px 14px;\n  border-radius: 3px;\n}\n.filter-tabs > button.selected {\n  background: #ccb37714;\n  border-color: #80714c;\n  color: #dcc591;\n}\n.filter-tabs > button:hover {\n  color: var(--gold);\n}\n.inventory-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 16px;\n}\n.item-tile {\n  --rarity: #aaa999;\n  background: linear-gradient(150deg, color-mix(in srgb, var(--rarity) 6%, #141b16), #111913);\n  border: 1px solid color-mix(in srgb, var(--rarity) 37%, #273326);\n  border-radius: 3px;\n  padding: 15px 16px 16px;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n.rarity-common {\n  --rarity: #b1b19e;\n}\n.rarity-uncommon {\n  --rarity: #8eae7c;\n}\n.rarity-rare {\n  --rarity: #80aabc;\n}\n.rarity-epic {\n  --rarity: #b199c7;\n}\n.rarity-legendary {\n  --rarity: #ddba74;\n}\n.item-tile-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 7px;\n}\n.rarity-label {\n  font-size: 8px;\n  text-transform: uppercase;\n  letter-spacing: 1.7px;\n  color: var(--rarity);\n}\n.equipped-tag {\n  display: flex;\n  align-items: center;\n  gap: 3px;\n  color: var(--green);\n  font-size: 8px;\n}\n.item-art {\n  height: 91px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  color: var(--rarity);\n  background: radial-gradient(\n    ellipse,\n    color-mix(in srgb, var(--rarity) 10%, transparent),\n    transparent 65%\n  );\n  margin: 9px 0 5px;\n}\n.item-art > svg {\n  filter: drop-shadow(0 4px 9px #0009);\n}\n.gear-portrait {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  filter: drop-shadow(0 9px 12px #0008);\n}\n.item-slot-label {\n  display: block;\n  margin-top: 7px;\n  color: var(--dim);\n  font-size: 9px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.armor-set-progress {\n  margin: 24px 0 8px;\n}\n.armor-set-progress .section-heading {\n  align-items: end;\n}\n.armor-set-progress .section-heading p {\n  margin: 4px 0 0;\n  color: var(--muted);\n  font-size: 12px;\n}\n.armor-set-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n}\n.armor-set-grid article {\n  padding: 20px;\n  background: linear-gradient(145deg, #16211a, #101713);\n  border: 1px solid var(--line);\n  border-radius: 4px;\n}\n.armor-set-grid article > span {\n  color: var(--gold);\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.armor-set-grid h3 {\n  margin: 7px 0 2px;\n  color: var(--text);\n  font-size: 23px;\n}\n.armor-set-grid article > small {\n  color: var(--dim);\n  font-size: 10px;\n}\n.armor-set-grid ul {\n  display: grid;\n  gap: 7px;\n  margin: 16px 0 0;\n  padding: 0;\n  list-style: none;\n}\n.armor-set-grid li {\n  color: #7f8c7d;\n  font-size: 11px;\n}\n.armor-set-grid li strong {\n  margin-right: 4px;\n}\n.armor-set-grid li.active {\n  color: #d9c486;\n}\n@media (max-width: 900px) {\n  .armor-set-grid {\n    grid-template-columns: 1fr;\n  }\n}\n@media (min-width: 701px) and (max-width: 1120px) {\n  body .loadout-summary {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  body .loadout-summary > div {\n    border-left: 1px solid var(--line);\n  }\n  body .loadout-summary > div:nth-child(odd) {\n    border-left: 0;\n  }\n  body .loadout-summary > div:nth-child(n + 3) {\n    border-top: 1px solid var(--line);\n  }\n}\n.item-tile h3 {\n  font-size: 23px;\n  line-height: 1.15;\n  color: var(--rarity);\n}\n.item-tile p {\n  font-size: 10px;\n  color: var(--muted);\n  margin-top: 8px;\n}\n.item-compare {\n  font-size: 9px;\n  display: block;\n  margin-top: 8px;\n}\n.item-actions {\n  display: flex;\n  justify-content: space-between;\n  gap: 7px;\n  margin-top: auto;\n  padding-top: 17px;\n}\n.item-actions .button {\n  min-height: 33px;\n  padding: 8px 10px;\n  font-size: 10px;\n  gap: 5px;\n}\n.item-actions .button:first-child {\n  flex: 1;\n}\n.empty-state {\n  padding: 48px 20px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  border: 1px dashed var(--line);\n  border-radius: 3px;\n  color: var(--gold);\n}\n.empty-state h3 {\n  font-size: 29px;\n  margin: 15px 0 8px;\n  color: var(--text);\n}\n.empty-state p {\n  color: var(--muted);\n  font-size: 12px;\n  max-width: 440px;\n}\n.inventory-lock {\n  font-size: 12px;\n  color: var(--gold);\n  margin: 0 0 17px;\n}\n/* Dungeons and battle preparation. */\n.dungeon-area-tabs {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 12px;\n  margin-bottom: 22px;\n}\n.area-tab {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  padding: 18px 19px;\n  background: #121b16;\n  border: 1px solid var(--line);\n  border-radius: 3px;\n  text-align: left;\n  min-width: 0;\n}\n.area-tab.selected {\n  border-color: #b4995e;\n  background: linear-gradient(120deg, #c4a66316, #c4a66302);\n}\n.area-tab:hover {\n  border-color: #726a48;\n}\n.area-tab > svg:last-child {\n  margin-left: auto;\n  color: var(--dim);\n}\n.area-number {\n  font-family: var(--serif);\n  font-size: 26px;\n  color: var(--gold);\n  min-width: 24px;\n  display: flex;\n}\n.area-tab strong {\n  font-family: var(--serif);\n  font-size: 23px;\n  font-weight: 500;\n  white-space: nowrap;\n}\n.area-tab small {\n  display: block;\n  font-size: 9px;\n  color: var(--muted);\n  margin-top: 4px;\n}\n.area-locked:not(.selected) {\n  opacity: 0.62;\n}\n.dungeon-layout {\n  display: grid;\n  grid-template-columns: 1.62fr 1fr;\n  gap: 20px;\n}\n.dungeon-scene {\n  position: relative;\n  min-height: 571px;\n  border: 1px solid #4f5c43;\n  border-radius: 3px;\n  overflow: hidden;\n}\n.dungeon-scene > img {\n  position: absolute;\n  object-position: 63% 50%;\n}\n.dungeon-scene-placeholder {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  background:\n    radial-gradient(circle at 68% 28%, color-mix(in srgb, var(--dungeon-glow) 42%, transparent), transparent 28%),\n    radial-gradient(circle at 24% 62%, color-mix(in srgb, var(--dungeon-glow) 20%, transparent), transparent 32%),\n    linear-gradient(145deg, var(--dungeon-deep), #07100c 74%);\n}\n.dungeon-scene-placeholder::before,\n.dungeon-scene-placeholder::after {\n  content: '';\n  position: absolute;\n  width: 62%;\n  height: 62%;\n  border: 1px solid color-mix(in srgb, var(--dungeon-glow) 36%, transparent);\n  transform: rotate(45deg);\n  box-shadow: 0 0 80px color-mix(in srgb, var(--dungeon-glow) 12%, transparent);\n}\n.dungeon-scene-placeholder::after {\n  width: 38%;\n  height: 38%;\n  transform: rotate(45deg) translate(22%, -18%);\n}\n.dungeon-scene-placeholder span {\n  font: 600 150px/1 'Cormorant Garamond', serif;\n  color: color-mix(in srgb, var(--dungeon-glow) 13%, transparent);\n  letter-spacing: -0.08em;\n}\n.dungeon-scene.frost {\n  --dungeon-deep: #11222b;\n  --dungeon-glow: #8fd2e6;\n}\n.dungeon-scene.sunken {\n  --dungeon-deep: #082421;\n  --dungeon-glow: #4dbeb4;\n}\n.dungeon-scene.starfall {\n  --dungeon-deep: #17152e;\n  --dungeon-glow: #b69cff;\n}\n.dungeon-scene:after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(#05100830, transparent 25%, #0510092e 45%, #071309f2);\n}\n.dungeon-scene-top {\n  position: absolute;\n  top: 23px;\n  left: 25px;\n  right: 25px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  z-index: 2;\n  gap: 10px;\n}\n.region-label {\n  font-size: 9px;\n  letter-spacing: 2px;\n  color: #d7dfc7;\n  text-shadow: 0 1px 7px #000;\n}\n.stage-chip {\n  background: #0b1c10b3;\n  border: 1px solid #83966a7a;\n  border-radius: 3px;\n  padding: 7px 10px;\n  font-size: 8px;\n  letter-spacing: 1px;\n  color: #d4dfbd;\n}\n.dungeon-scene-caption {\n  position: absolute;\n  z-index: 2;\n  bottom: 26px;\n  left: 30px;\n  right: 30px;\n}\n.dungeon-scene-caption h2 {\n  font-size: 49px;\n  text-shadow: 0 2px 9px #0005;\n}\n.dungeon-scene-caption > p {\n  max-width: 450px;\n  color: #bdccb1;\n  font-size: 12px;\n  line-height: 1.8;\n  margin: 12px 0 31px;\n}\n.stage-path {\n  display: flex;\n  justify-content: space-between;\n  gap: 0;\n}\n.stage-path button {\n  flex: 1;\n  background: none;\n  border: 0;\n  position: relative;\n  display: flex;\n  align-items: center;\n  flex-direction: column;\n  padding: 0;\n  gap: 11px;\n  opacity: 1;\n}\n.stage-path button:before {\n  content: '';\n  position: absolute;\n  left: -50%;\n  right: 50%;\n  height: 1px;\n  background: #9dab736b;\n  top: 19px;\n}\n.stage-path button:first-child:before {\n  display: none;\n}\n.stage-path button > span {\n  width: 39px;\n  height: 39px;\n  border: 1px solid #849070;\n  background: #18271d;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  position: relative;\n  z-index: 1;\n  color: #abb799;\n  font-family: var(--serif);\n  font-size: 20px;\n}\n.stage-path button small {\n  font-size: 8px;\n  letter-spacing: 1px;\n  color: #9cae8b;\n}\n.stage-path button.current > span {\n  background: var(--gold);\n  border-color: #ead298;\n  color: #26301b;\n  box-shadow: 0 0 20px #d1af6d39;\n}\n.stage-path button.current small {\n  color: #dfc181;\n}\n.stage-path button.complete > span {\n  border-color: #a7b37e;\n  color: #b1c790;\n}\n.stage-path button:disabled:not(.complete):not(.current) > span {\n  background: #111c15;\n  color: #67755e;\n  border-color: #526443;\n}\n.stage-path button:hover:not(:disabled) > span {\n  border-color: var(--gold);\n}\n.raid-preparation {\n  padding: 25px;\n}\n.raid-preparation > .section-heading {\n  margin-bottom: 8px;\n  color: var(--gold);\n}\n.raid-preparation > .section-heading .letter-label {\n  font-size: 9px;\n}\n.raid-preparation h2 {\n  font-size: 32px;\n  margin: 0 0 20px;\n}\n.raid-mode {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  border: 1px solid var(--line);\n  border-radius: 3px;\n  padding: 3px;\n  gap: 3px;\n}\n.raid-mode > button {\n  border: 1px solid transparent;\n  border-radius: 2px;\n  padding: 9px 5px;\n  background: none;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  font-size: 10px;\n  color: var(--muted);\n}\n.raid-mode > button.selected {\n  background: #c6ac6f1a;\n  border-color: #726440;\n  color: #e3c98d;\n}\n.mode-description {\n  font-size: 10px;\n  color: var(--muted);\n  line-height: 1.8;\n  margin: 13px 0 18px;\n  min-height: 37px;\n}\n.mode-description small {\n  display: block;\n  font-size: 9px;\n  color: var(--dim);\n}\n.tactic-picker > label {\n  font-size: 10px;\n  color: #bfccb7;\n  display: block;\n  margin-bottom: 9px;\n}\n.tactic-picker > div {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  gap: 6px;\n}\n.tactic-picker button {\n  background: #0e1711;\n  border: 1px solid var(--line);\n  padding: 9px 5px;\n  font-size: 9px;\n  color: #a9b49e;\n  border-radius: 2px;\n}\n.tactic-picker button.selected {\n  border-color: #9c8955;\n  background: #bca46a16;\n  color: #e1c88c;\n}\n.tactic-picker > small {\n  display: block;\n  font-size: 9px;\n  color: #899982;\n  margin-top: 9px;\n  line-height: 1.6;\n}\n.forecast {\n  margin: 21px 0;\n  padding: 18px 0;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n}\n.forecast-title {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  font-size: 10px;\n}\n.forecast-title > span {\n  color: #b1bea8;\n}\n.forecast-title > strong {\n  font-size: 10px;\n}\n.forecast-strength {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin: 17px 0 12px;\n}\n.forecast-strength > span:not(.versus) {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  flex-wrap: wrap;\n  font-family: var(--serif);\n  font-size: 30px;\n  width: 120px;\n}\n.forecast-strength > span:last-child {\n  justify-content: flex-end;\n  text-align: right;\n  color: #c09380;\n}\n.forecast-strength > span:first-child {\n  color: #c9d6b9;\n}\n.forecast-strength small {\n  display: block;\n  flex-basis: 100%;\n  font-family: Inter, sans-serif;\n  font-size: 9px;\n  color: var(--dim);\n  margin-top: -3px;\n}\n.versus {\n  font-size: 9px;\n  color: var(--dim);\n  letter-spacing: 2px;\n}\n.forecast-track {\n  height: 5px;\n  background: #794d3a7a;\n  overflow: hidden;\n}\n.forecast-track > span {\n  display: block;\n  height: 100%;\n  background: #97a873;\n  transition: width 0.3s;\n}\n.forecast-range {\n  display: block;\n  margin-top: 10px;\n  font-size: 8px;\n  color: #84937a;\n  line-height: 1.6;\n}\n.raid-rewards {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  flex-wrap: wrap;\n  margin-bottom: 21px;\n  font-size: 10px;\n}\n.raid-rewards > span {\n  color: var(--muted);\n}\n.raid-rewards strong {\n  margin-left: auto;\n  display: flex;\n  align-items: center;\n  color: var(--gold);\n  gap: 3px;\n  font-size: 12px;\n}\n.raid-rewards small {\n  width: 100%;\n  font-size: 9px;\n  color: #8f9e83;\n  margin-top: 3px;\n}\n.risk-ack {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  font-size: 10px;\n  color: #d8ac8e;\n  line-height: 1.7;\n  border: 1px solid #916343;\n  background: #84583212;\n  padding: 11px;\n  margin-bottom: 17px;\n  border-radius: 2px;\n}\n.risk-ack input {\n  margin: 2px 0 0;\n}\n.locked-message {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  font-size: 11px;\n  color: #ab9f79;\n  min-height: 43px;\n  border: 1px dashed #676344;\n}\n.dungeon-info-grid {\n  display: grid;\n  grid-template-columns: 1.62fr 1fr;\n  gap: 20px;\n  margin-top: 21px;\n}\n.loot-pool {\n  padding: 23px;\n}\n.loot-pool h2 {\n  font-size: 27px;\n}\n.loot-pool-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 7px 0 21px;\n}\n.loot-pool-row > span {\n  display: flex;\n  align-items: center;\n  flex-direction: column;\n  text-align: center;\n  gap: 9px;\n  flex: 1;\n  border-left: 1px solid var(--line);\n  color: var(--gold);\n}\n.loot-pool-row > span:first-child {\n  border-left: 0;\n}\n.loot-pool-row strong {\n  font-size: 10px;\n  color: #bec8b2;\n}\n.loot-pool-row small {\n  font-size: 9px;\n  color: #87987e;\n}\n.loot-pool details {\n  border-top: 1px solid var(--line);\n  padding-top: 13px;\n}\ndetails summary {\n  font-size: 10px;\n  color: #b1b896;\n  cursor: pointer;\n  line-height: 1.7;\n}\ndetails p {\n  font-size: 10px;\n  color: var(--muted);\n  margin-top: 11px;\n  line-height: 1.8;\n}\n.risk-panel {\n  padding: 24px;\n  color: var(--gold);\n}\n.risk-panel h3 {\n  font-size: 26px;\n  margin: 9px 0;\n  color: var(--text);\n}\n.risk-panel p {\n  font-size: 11px;\n  line-height: 1.8;\n  color: var(--muted);\n}\n.risk-panel > .positive {\n  font-size: 9px;\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  margin-top: 19px;\n}\n.expedition-banner {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  padding: 20px 23px;\n  margin-bottom: 20px;\n  background: #bda56013;\n  border: 1px solid #aa8b4d;\n  border-radius: 3px;\n  color: var(--gold);\n}\n.expedition-banner > div {\n  flex: 1;\n}\n.expedition-banner h3 {\n  color: #e0d3ad;\n}\n.expedition-banner p {\n  font-size: 11px;\n  color: #b8bc9e;\n  margin-top: 5px;\n}\n/* War room and the seasonal story. */\n.season-days {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  white-space: nowrap;\n  font-size: 11px;\n  color: var(--gold);\n  padding: 10px 14px;\n  border: 1px solid #615c3b;\n  border-radius: 3px;\n}\n.war-layout {\n  display: grid;\n  grid-template-columns: 1.2fr 1fr;\n  gap: 20px;\n}\n.war-season-hero {\n  position: relative;\n  min-height: 279px;\n  overflow: hidden;\n  border: 1px solid #625b3e;\n  border-radius: 3px;\n}\n.war-season-hero img {\n  position: absolute;\n  object-position: center 45%;\n}\n.war-season-hero:after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(90deg, #111c16ed, transparent 100%);\n}\n.war-season-hero > div {\n  position: relative;\n  z-index: 2;\n  padding: 29px 30px;\n}\n.war-season-hero h2 {\n  font-size: 47px;\n  margin: 9px 0;\n}\n.war-season-hero p {\n  font-size: 12px;\n  color: #c7cdb7;\n  line-height: 1.8;\n}\n.simulation-pill {\n  display: inline-block;\n  padding: 7px 9px;\n  background: #142015a3;\n  border: 1px solid #76826970;\n  border-radius: 3px;\n  font-size: 8px;\n  color: #bac4a9;\n  margin-top: 24px;\n  letter-spacing: 0.5px;\n}\n.faction-standings {\n  padding: 24px 26px;\n}\n.faction-standings .section-heading {\n  margin-bottom: 24px;\n}\n.faction-standings .influence-row {\n  font-size: 12px;\n}\n.faction-standings .influence-track {\n  height: 7px;\n}\n.faction-standings .influence-list {\n  gap: 17px;\n}\n.faction-standings > p {\n  font-size: 9px;\n  margin-top: 20px;\n  line-height: 1.7;\n}\n.allegiance-bar {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  padding: 22px 24px;\n  margin: 20px 0 26px;\n}\n.allegiance-emblem {\n  color: var(--gold);\n  width: 53px;\n  display: flex;\n  justify-content: center;\n}\n.allegiance-bar > div {\n  flex: 1;\n}\n.allegiance-bar h3 {\n  font-size: 28px;\n  margin-top: 4px;\n}\n.allegiance-bar p {\n  font-size: 10px;\n  color: var(--muted);\n  margin-top: 5px;\n}\n.allegiance-bar .letter-label {\n  font-size: 8px;\n}\n.allegiance-bar .renown-total {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--gold);\n  flex-wrap: wrap;\n  max-width: 130px;\n  justify-content: center;\n  padding-left: 23px;\n  border-left: 1px solid var(--line);\n}\n.renown-total strong {\n  font-family: var(--serif);\n  font-size: 35px;\n}\n.renown-total span {\n  display: block;\n  flex-basis: 100%;\n  font-size: 9px;\n  text-align: center;\n  color: var(--muted);\n}\n.battlefield {\n  padding: 23px 25px;\n}\n.battlefield h2 {\n  font-size: 28px;\n}\n.battlefield > p {\n  font-size: 11px;\n}\n.opponents-table {\n  margin-top: 25px;\n}\n.opponent-header,\n.opponent-row {\n  display: grid;\n  grid-template-columns: minmax(180px, 1.75fr) minmax(110px, 1fr) 0.6fr 0.75fr 133px;\n  gap: 16px;\n  align-items: center;\n}\n.opponent-header {\n  padding: 0 0 12px;\n  border-bottom: 1px solid #41503b;\n  font-size: 8px;\n  letter-spacing: 1px;\n  color: #819478;\n}\n.opponent-row {\n  padding: 19px 0;\n  border-bottom: 1px solid var(--line);\n}\n.opponent-row:last-child {\n  border-bottom: 0;\n  padding-bottom: 0;\n}\n.opponent-identity {\n  display: flex;\n  align-items: center;\n  gap: 13px;\n}\n.realm-avatar {\n  display: grid;\n  place-items: center;\n  width: 39px;\n  height: 39px;\n  border: 1px solid #7473566e;\n  border-radius: 3px;\n  background: #a6926620;\n  font-family: var(--serif);\n  font-size: 25px;\n  flex-shrink: 0;\n}\n.opponent-identity strong {\n  display: block;\n  font-size: 12px;\n}\n.opponent-identity > div > span {\n  font-size: 9px;\n  color: var(--muted);\n  display: block;\n  margin-top: 6px;\n}\n.opponent-faction,\n.opponent-defense {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 10px;\n}\n.opponent-defense {\n  font-size: 12px;\n  color: #b6c3a9;\n}\n.opponent-defense svg {\n  color: var(--dim);\n}\n.opponent-gold {\n  color: var(--gold);\n  font-size: 11px;\n}\n.opponent-row .button {\n  min-height: 34px;\n  padding: 9px 10px;\n  font-size: 9px;\n  gap: 6px;\n}\n.season-details-grid {\n  display: grid;\n  grid-template-columns: 1.2fr 1fr;\n  gap: 20px;\n}\n.season-rules,\n.season-rewards {\n  padding: 30px;\n}\n.section-icon,\n.season-rewards > svg {\n  color: var(--gold);\n}\n.season-rules h2,\n.season-rewards h2 {\n  font-size: 31px;\n  margin: 18px 0 12px;\n}\n.season-rules > p {\n  font-size: 12px;\n  color: var(--muted);\n}\n.score-breakdown {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n  padding: 20px 0;\n  margin: 23px 0;\n}\n.score-breakdown > div {\n  text-align: center;\n  border-left: 1px solid var(--line);\n}\n.score-breakdown > div:first-child {\n  border: 0;\n}\n.score-breakdown strong {\n  font-family: var(--serif);\n  color: var(--gold);\n  font-size: 34px;\n}\n.score-breakdown span {\n  display: block;\n  font-size: 9px;\n  color: #a5b393;\n  margin-top: 5px;\n}\n.season-rules details {\n  margin-top: 21px;\n}\n.reward-row {\n  display: flex;\n  align-items: flex-start;\n  gap: 15px;\n  margin: 22px 0;\n  color: var(--gold);\n}\n.reward-row > svg {\n  width: 21px;\n  margin-top: 4px;\n}\n.reward-row h3 {\n  color: var(--text);\n  font-size: 23px;\n}\n.reward-row p {\n  font-size: 11px;\n  color: var(--muted);\n  margin-top: 4px;\n  line-height: 1.8;\n}\n.war-donation {\n  display: flex;\n  align-items: center;\n  gap: 22px;\n  padding: 25px;\n  margin-top: 24px;\n}\n.donation-icon {\n  color: var(--gold);\n}\n.war-donation > div {\n  flex: 1;\n}\n.war-donation h2 {\n  font-size: 29px;\n}\n.war-donation p {\n  font-size: 11px;\n  color: var(--muted);\n  margin-top: 7px;\n}\n.donation-track {\n  max-width: 290px;\n  background: #303f30;\n  height: 4px;\n  margin-top: 15px;\n}\n.donation-track span {\n  display: block;\n  height: 100%;\n  background: var(--gold);\n}\n.scout-spoils {\n  display: flex;\n  justify-content: space-between;\n  color: var(--gold);\n  font-size: 13px;\n  margin: 20px 0;\n}\n.scout-spoils > span:first-child {\n  color: var(--muted);\n  font-size: 11px;\n}\n.scout-spoils ~ .button {\n  margin-top: 24px;\n}\n/* Trader and loot. */\n.trader-wallet {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n  color: var(--gold);\n  white-space: nowrap;\n}\n.trader-welcome {\n  display: flex;\n  align-items: center;\n  gap: 25px;\n  padding: 27px;\n}\n.trader-portrait {\n  border: 1px solid #7b6946;\n  border-radius: 50% 50% 2px 2px;\n  display: grid;\n  place-items: center;\n  width: 82px;\n  height: 92px;\n  flex-shrink: 0;\n  color: var(--gold);\n  background: radial-gradient(#c0a36626, transparent);\n}\n.trader-welcome h2 {\n  font-size: 33px;\n}\n.trader-welcome p {\n  font-size: 11px;\n  color: var(--muted);\n  margin-top: 7px;\n  max-width: 580px;\n}\n.trader-welcome > div > span {\n  display: block;\n  font-size: 8px;\n  color: #8b967e;\n  letter-spacing: 1.6px;\n  margin-top: 14px;\n}\n.pity-counter {\n  margin-left: auto;\n  flex-shrink: 0;\n  border-left: 1px solid var(--line);\n  padding-left: 25px;\n  text-align: center;\n  max-width: 205px;\n}\n.pity-counter > svg {\n  color: var(--gold);\n  display: inline-block;\n  margin-right: 9px;\n}\n.pity-counter strong {\n  font-family: var(--serif);\n  font-size: 41px;\n  color: var(--gold);\n  line-height: 1;\n}\n.trader-welcome .pity-counter > span {\n  font-size: 9px;\n  letter-spacing: 0;\n  margin-top: 7px;\n  color: var(--muted);\n}\n.pity-dots {\n  display: flex;\n  gap: 4px;\n  margin-top: 12px;\n  justify-content: center;\n}\n.pity-dots > span {\n  width: 10px;\n  height: 4px;\n  background: #3e4937;\n  border-radius: 1px;\n}\n.pity-dots > span.filled {\n  background: var(--gold);\n}\n.chest-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 19px;\n  margin-top: 25px;\n}\n.chest-card {\n  overflow: hidden;\n}\n.chest-art {\n  height: 215px;\n  position: relative;\n  overflow: hidden;\n  border-bottom: 1px solid #484d35;\n}\n.chest-art:after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(transparent 65%, #141c18);\n}\n.chest-art img {\n  object-position: center 55%;\n  transition: transform 0.5s;\n}\n.chest-card:hover .chest-art img {\n  transform: scale(1.045);\n}\n.chest-tier-label {\n  position: absolute;\n  top: 17px;\n  left: 19px;\n  z-index: 2;\n  letter-spacing: 1.5px;\n  font-size: 8px;\n  color: #b4b697;\n  background: #101812aa;\n  padding: 5px 7px;\n}\n.chest-tier-1 {\n  border-color: #5e6548;\n}\n.chest-tier-1 .chest-art img {\n  filter: saturate(0.65);\n}\n.chest-tier-2 {\n  border-color: #857044;\n}\n.chest-tier-2 .chest-art img {\n  filter: brightness(1.14);\n}\n.chest-tier-2 .chest-tier-label {\n  color: #e1c485;\n}\n.chest-card-copy {\n  padding: 23px;\n}\n.chest-card-copy h2 {\n  font-size: 29px;\n}\n.chest-card-copy > p {\n  font-size: 11px;\n  color: var(--muted);\n  margin: 9px 0 20px;\n  min-height: 18px;\n}\n.chest-guarantee {\n  color: #c0c8aa;\n  font-size: 10px;\n  margin-bottom: 15px;\n}\n.chest-card-copy details {\n  margin-top: 17px;\n  text-align: center;\n}\n.chest-card-copy details > p {\n  text-align: left;\n  font-size: 9px;\n}\n.chest-odds {\n  margin: 14px 0 0;\n  border-top: 1px solid var(--line);\n  padding-top: 10px;\n}\n.chest-odds > div {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin: 8px 0;\n  font-size: 10px;\n  color: var(--rarity);\n  text-transform: capitalize;\n}\n.fair-loot-note {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: #9daa89;\n  font-size: 10px;\n  padding: 21px 0;\n  border-bottom: 1px solid var(--line);\n}\n.fair-loot-note svg {\n  color: var(--gold);\n}\n.fair-loot-note small {\n  margin-left: auto;\n  font-size: 9px;\n  white-space: nowrap;\n}\n/* Focused dialogs, receipts, and feedback. */\n.dialog {\n  color: var(--text);\n  border: 1px solid #77663f;\n  border-radius: 5px;\n  background: #141d17;\n  box-shadow: 0 25px 100px #000b;\n  padding: 0;\n  width: min(620px, calc(100vw - 36px));\n  max-height: calc(100dvh - 48px);\n  position: fixed;\n  overflow-y: auto;\n  scrollbar-color: #665d3f #152019;\n}\n.dialog::backdrop {\n  background: #020703bf;\n  backdrop-filter: blur(5px);\n}\n.dialog[open] {\n  animation: dialog-arrive 0.23s ease-out;\n}\n.dialog-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 18px 23px;\n  border-bottom: 1px solid var(--line);\n  gap: 16px;\n  background: #101912;\n  position: sticky;\n  top: 0;\n  z-index: 5;\n}\n.dialog-heading h2 {\n  font-size: 28px;\n}\n.dialog-heading .icon-button {\n  margin: -3px -7px -3px 0;\n}\n.dialog-body {\n  padding: 25px;\n}\n.dialog-lead {\n  font-size: 12px;\n  line-height: 1.85;\n  color: #b4bfa9;\n  margin-bottom: 24px;\n  max-width: 650px;\n}\n.dialog-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 24px;\n  flex-wrap: wrap;\n}\n.faction-dialog {\n  width: min(810px, calc(100vw - 36px));\n}\n.faction-options {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n}\n.faction-choice {\n  background: #0e1912;\n  border: 1px solid #364433;\n  border-radius: 3px;\n  text-align: left;\n  padding: 21px;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n.faction-choice.selected {\n  border-color: var(--faction-color);\n  background: linear-gradient(\n    135deg,\n    color-mix(in srgb, var(--faction-color) 13%, #152019),\n    #111b14\n  );\n  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--faction-color) 18%, transparent);\n}\n.faction-choice:hover:not(:disabled) {\n  border-color: var(--faction-color);\n}\n.faction-choice-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: var(--faction-color);\n  margin-bottom: 15px;\n}\n.faction-choice-sigil {\n  height: 49px;\n  display: flex;\n  align-items: center;\n}\n.choice-circle {\n  height: 17px;\n  width: 17px;\n  border-radius: 50%;\n  border: 1px solid #727962;\n}\n.faction-choice h3 {\n  font-size: 30px;\n}\n.faction-choice em {\n  font-size: 11px;\n  color: var(--faction-color);\n  font-family: var(--serif);\n  font-size: 17px;\n  margin-top: 6px;\n}\n.faction-choice p {\n  font-size: 10px;\n  color: #a5b29a;\n  line-height: 1.8;\n  margin: 12px 0 17px;\n  max-width: 290px;\n}\n.faction-bonus {\n  color: var(--faction-color);\n  font-size: 10px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  border-top: 1px solid #59624566;\n  padding-top: 12px;\n  margin-top: auto;\n  width: 100%;\n}\n.oath-footer {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  justify-content: space-between;\n  margin-top: 23px;\n}\n.oath-footer p {\n  font-size: 10px;\n  line-height: 1.8;\n}\n.oath-footer .button {\n  font-size: 11px;\n}\n.battle-dialog {\n  width: min(700px, calc(100vw - 36px));\n}\n.battle-report-scene {\n  position: relative;\n  height: 250px;\n  overflow: hidden;\n}\n.battle-report-scene > img {\n  object-position: center 49%;\n}\n.battle-report-scene:after {\n  position: absolute;\n  content: '';\n  inset: 0;\n  background: linear-gradient(#0c1b0c70, #0b180ddd);\n}\n.battle-result {\n  position: absolute;\n  z-index: 2;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n}\n.battle-result-emblem {\n  color: var(--gold);\n  padding: 8px 0 13px;\n}\n.battle-result > .letter-label {\n  font-size: 8px;\n  letter-spacing: 2px;\n}\n.battle-result h2 {\n  font-size: 47px;\n  margin: 6px 0;\n}\n.battle-result p {\n  font-family: var(--serif);\n  font-size: 21px;\n  color: #d1d8be;\n}\n.battle-lost .battle-result-emblem,\n.battle-lost .battle-result > .letter-label {\n  color: var(--danger);\n}\n.battle-totals {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  border-bottom: 1px solid var(--line);\n  padding-bottom: 21px;\n}\n.battle-totals > div {\n  text-align: center;\n  border-left: 1px solid var(--line);\n}\n.battle-totals > div:first-child {\n  border-left: 0;\n}\n.battle-totals strong {\n  font-family: var(--serif);\n  font-size: 33px;\n}\n.battle-totals small {\n  display: block;\n  font-size: 9px;\n  color: var(--muted);\n  margin-top: 4px;\n}\n.battle-receipt {\n  opacity: 0.28;\n  transition: opacity 0.4s;\n}\n.battle-receipt.revealed {\n  opacity: 1;\n}\n.victory-loot {\n  display: flex;\n  align-items: center;\n  gap: 21px;\n  padding: 22px 0 17px;\n  color: var(--gold);\n  font-size: 12px;\n}\n.victory-loot > span {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n.victory-loot > span:last-child {\n  margin-left: auto;\n  font-size: 10px;\n}\n.battle-log {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.battle-log > li {\n  font-size: 11px;\n  line-height: 1.8;\n  color: #aab99b;\n  display: flex;\n  align-items: flex-start;\n  gap: 14px;\n}\n.battle-log > li > span {\n  font-size: 9px;\n  color: #718668;\n  padding-top: 2px;\n  flex-shrink: 0;\n}\n.battle-items {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));\n  gap: 14px;\n  margin-top: 23px;\n}\n.battle-items .item-art {\n  height: 58px;\n}\n.battle-items .item-tile h3 {\n  font-size: 22px;\n}\n.defeat-cost {\n  display: flex;\n  align-items: flex-start;\n  gap: 9px;\n  color: #d0a689;\n  font-size: 11px;\n  line-height: 1.8;\n  padding: 21px 0;\n}\n.defeat-cost > svg {\n  margin-top: 2px;\n}\n.chest-dialog {\n  width: min(480px, calc(100vw - 36px));\n}\n.chest-reveal {\n  position: relative;\n  height: 253px;\n  overflow: hidden;\n}\n.chest-reveal > img {\n  object-position: center 52%;\n  animation: chest-breathe 1.1s ease-in-out infinite;\n}\n.chest-reveal.revealed > img {\n  animation: none;\n  transform: scale(1.03);\n}\n.chest-reveal:after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(transparent 60%, #141d17);\n}\n.chest-reveal > span {\n  position: absolute;\n  bottom: 14px;\n  left: 0;\n  right: 0;\n  z-index: 2;\n  text-align: center;\n  color: var(--rarity);\n  letter-spacing: 2.5px;\n  font-size: 9px;\n}\n.chest-reveal-sparks {\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(ellipse at 50% 58%, #e6c76a3b, transparent 58%);\n  opacity: 0;\n  transition: opacity 1.1s;\n}\n.revealed .chest-reveal-sparks {\n  opacity: 1;\n}\n.chest-dialog .item-tile {\n  border: 0;\n  background: transparent;\n  text-align: center;\n  padding: 0;\n}\n.chest-dialog .item-tile-top {\n  justify-content: center;\n}\n.chest-dialog .item-art {\n  height: 76px;\n  margin: 0;\n}\n.chest-dialog .item-tile h3 {\n  font-size: 37px;\n}\n.chest-dialog .item-tile p {\n  font-size: 12px;\n