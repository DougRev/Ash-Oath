in-stats {\n    gap: 8px;\n  }\n  .admin-stats article {\n    padding: 13px;\n    font-size: 12px;\n  }\n  .admin-stats strong {\n    font-size: 28px;\n  }\n  .admin-columns {\n    grid-template-columns: 1fr;\n  }\n  .admin-panel {\n    padding: 18px;\n  }\n  .admin-switch {\n    bottom: 78px;\n    right: 14px;\n    font-size: 12px;\n  }\n  .admin-search {\n    display: grid;\n  }\n  .admin-search input {\n    min-width: 0;\n    width: 100%;\n  }\n}\n/* Keep this management surface readable independently of the game's dark theme. */\n.admin-dashboard {\n  background: #f3f1e7;\n  min-height: 100vh;\n}\n.admin-dashboard .button-secondary {\n  color: #3c503d;\n  border-color: #7f8b75;\n  background: #faf9f2;\n}\n.admin-dashboard a {\n  color: #385e46;\n}\n.admin-dashboard .letter-label {\n  color: #826127;\n}\n@media (max-width: 650px) {\n  .admin-table-wrap {\n    overflow: visible;\n  }\n  .admin-dashboard thead {\n    display: none;\n  }\n  .admin-dashboard table,\n  .admin-dashboard tbody,\n  .admin-dashboard tr,\n  .admin-dashboard td {\n    display: block;\n    width: 100%;\n  }\n  .admin-dashboard tr {\n    border: 1px solid #dedccc;\n    border-radius: 8px;\n    margin: 14px 0;\n    padding: 8px;\n  }\n  .admin-dashboard td {\n    padding: 10px 5px;\n  }\n  .admin-dashboard td:before {\n    display: block;\n    color: #666c59;\n    font-size: 11px;\n    font-weight: 600;\n    text-transform: uppercase;\n    margin-bottom: 5px;\n  }\n  .admin-dashboard td:nth-child(1):before {\n    content: 'Commander';\n  }\n  .admin-dashboard td:nth-child(2):before {\n    content: 'Faction / tier';\n  }\n  .admin-dashboard td:nth-child(3):before {\n    content: 'Treasury';\n  }\n  .admin-dashboard td:nth-child(4):before {\n    content: 'Status';\n  }\n  .admin-dashboard td:last-child {\n    border-bottom: 0;\n  }\n  .admin-dashboard td .button {\n    width: 100%;\n  }\n}\n.admin-balance .admin-actions {\n  flex-wrap: wrap;\n  align-items: end;\n}\n.admin-balance label {\n  display: grid;\n  gap: 6px;\n  font-size: 13px;\n}\n.admin-balance input,\n.admin-balance select {\n  padding: 10px;\n  border: 1px solid #b8bcae;\n  border-radius: 6px;\n  background: #faf9f2;\n  color: #26382b;\n  max-width: 100%;\n}\n@media (max-width: 650px) {\n  .admin-balance .admin-table-wrap {\n    overflow-x: auto;\n  }\n  .admin-balance table {\n    display: table;\n    min-width: 620px;\n  }\n  .admin-balance thead {\n    display: table-header-group;\n  }\n  .admin-balance tbody {\n    display: table-row-group;\n  }\n  .admin-balance tr {\n    display: table-row;\n  }\n  .admin-balance td {\n    display: table-cell;\n    width: auto;\n    padding: 10px;\n  }\n  .admin-balance td:before {\n    display: none;\n  }\n}\n"],["STYLE",{},".party-picker,\n.enemy-intel,\n.combat-exchange {\n  padding: 16px;\n  margin: 16px 0;\n  border: 1px solid var(--border, #42483c);\n  border-radius: 10px;\n  background: #ffffff06;\n}\n.party-picker label,\n.party-picker small,\n.companion-details small,\n.unit-weapon small {\n  display: block;\n  line-height: 1.55;\n  margin: 6px 0;\n}\n.party-picker input[type='number'] {\n  width: 90px;\n  padding: 10px;\n  border: 1px solid #767b67;\n  border-radius: 6px;\n  background: #19221e;\n  color: #f3ecd9;\n  margin: 10px 0;\n}\n.party-picker input[type='range'] {\n  display: block;\n  width: 100%;\n  accent-color: #c5a467;\n}\n.enemy-intel p,\n.casualty-forecast {\n  line-height: 1.6;\n  font-size: 13px;\n}\n.casualty-forecast {\n  display: block;\n  color: #ddbd83;\n  margin: 14px 0;\n}\n.unit-weapon-options {\n  margin-top: 24px;\n  border-top: 1px solid #42483c;\n  padding-top: 18px;\n}\n.unit-weapon-options p {\n  font-size: 13px;\n  line-height: 1.6;\n  color: #b8bbac;\n}\n.unit-weapon {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 15px 0;\n  border-bottom: 1px solid #42483c;\n}\n.unit-weapon small {\n  font-size: 12px;\n  color: #b8bbac;\n}\n.unit-weapon button {\n  flex-shrink: 0;\n}\n.companion-details {\n  font-size: 12px;\n  line-height: 1.6;\n  width: 100%;\n}\n@media (max-width: 600px) {\n  .unit-weapon {\n    align-items: stretch;\n    flex-direction: column;\n  }\n  .unit-weapon button {\n    width: 100%;\n  }\n  .combat-exchange p {\n    font-size: 13px;\n  }\n}\n.boss-portrait {\n  width: 100%;\n  height: 190px;\n  object-fit: cover;\n  object-position: center 35%;\n  border-radius: 10px;\n  margin: 15px 0;\n}\n.battle-dialog .battle-log > li {\n  font-size: 13px;\n  line-height: 1.7;\n}\n.battle-dialog .combat-exchange {\n  border-color: #687650;\n  background: #202a20;\n}\n.battle-dialog .combat-exchange p {\n  font-size: 14px;\n  color: #e6ddc1;\n  line-height: 1.8;\n}\n.battle-dialog .combat-exchange small {\n  color: #abb79e;\n  font-size: 11px;\n  line-height: 1.6;\n}\n.battle-dialog .defeat-cost {\n  font-size: 13px;\n}\n.army-summary {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 24px;\n  margin: 22px 0;\n}\n.army-summary p,\n.army-workspace p {\n  font-size: 13px;\n  line-height: 1.7;\n  color: #aebaa3;\n}\n.army-workspace {\n  display: grid;\n  grid-template-columns: 280px 1fr;\n  gap: 22px;\n  align-items: start;\n}\n.muster-panel,\n.equipment-workshop {\n  padding: 24px;\n}\n.muster-panel {\n  position: sticky;\n  top: 90px;\n}\n.muster-panel > .button {\n  width: 100%;\n  margin: 8px 0;\n}\n.muster-panel small {\n  display: block;\n  line-height: 1.7;\n  color: #aebaa3;\n  margin-top: 18px;\n}\n.muster-stats {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 14px;\n  margin: 24px 0;\n}\n.muster-stats span {\n  font-size: 12px;\n  color: #aebaa3;\n}\n.muster-stats strong {\n  display: block;\n  font-size: 30px;\n  color: #e4d6b5;\n}\n.purchase-quantity {\n  display: block;\n  font-size: 12px;\n  margin: 18px 0;\n}\n.purchase-quantity select {\n  display: block;\n  width: 100%;\n  margin-top: 9px;\n  background: #19221e;\n  color: #e4d6b5;\n  padding: 12px;\n  border: 1px solid #697459;\n  border-radius: 6px;\n}\n.equipment-row {\n  display: grid;\n  grid-template-columns: 1fr 180px;\n  gap: 20px;\n  border-top: 1px solid #374331;\n  padding: 22px 0;\n}\n.equipment-row h3 {\n  font-size: 24px;\n  margin: 0;\n}\n.equipment-controls {\n  display: flex;\n  flex-direction: column;\n  gap: 9px;\n}\n.equipment-counts {\n  display: flex;\n  gap: 18px;\n  font-size: 12px;\n  color: #acb99c;\n}\n.equipment-counts strong {\n  display: block;\n  font-size: 19px;\n  color: #dfd4b8;\n}\n.dungeon-info-grid {\n  grid-template-columns: 1fr;\n}\n@media (max-width: 900px) {\n  .army-workspace {\n    grid-template-columns: 1fr;\n  }\n  .muster-panel {\n    position: static;\n  }\n  .muster-stats {\n    grid-template-columns: repeat(4, 1fr);\n  }\n  .army-summary {\n    align-items: stretch;\n    flex-direction: column;\n  }\n}\n@media (max-width: 560px) {\n  .equipment-row {\n    grid-template-columns: 1fr;\n  }\n  .equipment-controls {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n  .equipment-controls .button {\n    font-size: 12px;\n    padding: 10px;\n  }\n  .muster-panel,\n  .equipment-workshop {\n    padding: 18px;\n  }\n}\n.bank-panel {\n  margin-bottom: 28px;\n  padding: 26px;\n}\n.bank-panel h2 {\n  margin: 8px 0;\n  font-size: 30px;\n}\n.bank-panel p {\n  color: var(--muted);\n  line-height: 1.6;\n  max-width: 850px;\n}\n.bank-balances,\n.bank-controls {\n  display: flex;\n  gap: 24px;\n  flex-wrap: wrap;\n  align-items: end;\n  margin: 20px 0;\n}\n.bank-balances > div {\n  display: grid;\n  gap: 8px;\n  min-width: 180px;\n}\n.bank-balances small,\n.bank-panel > small {\n  color: var(--muted);\n}\n.bank-controls label {\n  display: grid;\n  gap: 8px;\n  font-size: 13px;\n}\n.bank-controls input,\n.bank-controls select {\n  padding: 12px;\n  background: #151e18;\n  color: #e5dfcd;\n  border: 1px solid #455344;\n  border-radius: 6px;\n  max-width: 100%;\n}\n@media (max-width: 650px) {\n  .bank-panel {\n    padding: 18px;\n  }\n  .bank-controls {\n    gap: 12px;\n  }\n  .bank-controls label {\n    width: 100%;\n  }\n}\n.rival-panel {\n  margin-bottom: 24px;\n  padding: 26px;\n}\n.rival-panel h2 {\n  font-size: 32px;\n  margin: 8px 0;\n}\n.rival-panel p,\n.rival-panel > small {\n  color: var(--muted);\n  line-height: 1.6;\n}\n.rival-panel label {\n  display: flex;\n  gap: 14px;\n  align-items: center;\n  margin: 22px 0;\n  font-size: 13px;\n}\n.rival-panel select {\n  background: #172219;\n  color: #e5dfcd;\n  border: 1px solid #455344;\n  border-radius: 6px;\n  padding: 10px;\n}\n.rival-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n  margin-bottom: 20px;\n}\n.rival-card {\n  border: 1px solid #394738;\n  border-radius: 7px;\n  padding: 22px;\n  background: linear-gradient(145deg, #263221, #151d17);\n}\n.rival-card h3 {\n  font-size: 27px;\n  margin: 15px 0 4px;\n}\n.rival-card .button {\n  width: 100%;\n  margin-top: 20px;\n}\n.rival-stats {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.rival-stats > span {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n@media (max-width: 900px) {\n  .rival-grid {\n    grid-template-columns: 1fr;\n  }\n  .rival-panel {\n    padding: 18px;\n  }\n  .rival-panel .section-heading {\n    align-items: start;\n    gap: 15px;\n    flex-direction: column;\n  }\n  .rival-panel label {\n    flex-wrap: wrap;\n  }\n}\n.purchase-quantity input,\n.equipment-controls input {\n  width: 100%;\n  padding: 11px;\n  background: #121b15;\n  color: #eee4ca;\n  border: 1px solid #455443;\n  border-radius: 5px;\n}\n.order-presets,\n.stock-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.order-presets {\n  margin: 8px 0 12px;\n}\n.order-presets button {\n  padding: 6px 10px;\n  background: #253023;\n  border: 1px solid #495640;\n  border-radius: 5px;\n  color: #ded6bd;\n  cursor: pointer;\n}\n.order-presets button:disabled {\n  opacity: 0.4;\n}\n.tr